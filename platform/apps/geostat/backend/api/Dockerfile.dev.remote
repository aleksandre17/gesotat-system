# Remote source dev image (geostat api dev bootstrap): toolchain only.
# Source is bind-mounted at /app and run with `gradlew :api:bootRun` by the kit.
FROM eclipse-temurin:17-jdk-jammy
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*
# Shared JVM security policy (same file as the production image).
COPY api/docker/legacy-sqlserver-tls.security /tmp/legacy-sqlserver-tls.security
RUN cat /tmp/legacy-sqlserver-tls.security >> "$JAVA_HOME/conf/security/java.security" \
    && rm /tmp/legacy-sqlserver-tls.security
WORKDIR /app
