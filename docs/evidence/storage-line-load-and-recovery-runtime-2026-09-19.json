{
  "schema": "geostat.storage-line-load-and-recovery-runtime.v1",
  "recordedAt": "2026-09-19",
  "checklistItem": "docs/work/STORAGE-ARTIFACT-CLOSURE-CHECKLIST.md 14.5 (rollback, replay, load/performance and recovery evidence)",
  "closes": [
    "load / performance under concurrency on the deployed dev revision",
    "recovery of durable state across an API container restart",
    "replay / idempotency of the governed package run under concurrency"
  ],
  "doesNotClose": [
    "rollback of a publication (publishing snapshot 53 is an owner/steward approval, ADR-007; nothing was published, so nothing was rolled back)",
    "object storage backup/restore (checklist 4.7, EXT B-06)"
  ],
  "environment": {
    "target": "remote dev API, container geostat-api-dev, http://localhost:8081 on the server, OIDC enforced",
    "sourceRevision": "branch storage/artifact-line-closure (working tree clean); the dev container runs this source",
    "authentication": "Keycloak confidential client geostat-artifact-operator, client_credentials; tokens obtained on the server, kept only in process memory, refreshed every 120 s, never printed or persisted",
    "productionOnSameHost": "container geostat-api on localhost:8083 with shared MinIO, Keycloak and edge; production containers and the production database were never touched",
    "host": "6 CPU, 7.75 GiB RAM, shared with production and ~40 other containers",
    "loadOrigin": "the server itself (loopback), so the numbers exclude network transport between client and API"
  },
  "tool": {
    "name": "ops/tests/load/load_probe.py + ops/tests/load/recovery_probe.py driven by ops/tests/load/remote-load-phase.sh",
    "runtime": "python3 3.12.3 on the server, thread pool over urllib, one probe process per phase",
    "whyNotAnExistingTool": "ab, hey and wrk are absent on the server and installing system packages is not allowed; pulling a container image (for example grafana/k6) was rejected because the host has ~1 GiB of free memory and is shared with production. python3 with a thread pool gives per-request latency, status codes, response headers, watchdog sampling and the abort logic in one process with no installation.",
    "siteAgnostic": "base URL, endpoint list, concurrency, duration, watch URLs, expected health substring, abort thresholds, sampled container names and the token command are all arguments; no project, site or endpoint value is hardcoded in the probes"
  },
  "admissionControl": {
    "filter": "PlatformRateLimitFilter",
    "configuredLimit": "PLATFORM_RATE_LIMIT_REQUESTS=120 per PLATFORM_RATE_LIMIT_WINDOW_MS=60000, per client key, in-memory store (PLATFORM_RATE_LIMIT_REDIS_ENABLED=false)",
    "observedHeaders": [
      "RateLimit-Policy: 120;w=60",
      "RateLimit-Limit: 120",
      "Retry-After: <seconds to window end>"
    ],
    "consequenceForThisTest": "the whole load ran as one OIDC client, therefore one client key, therefore a ceiling of 120 admitted requests per minute regardless of offered load. Every phase above that ceiling is a measurement of bounded admission, not of backend capacity. This is recorded as an observed property of the platform, not as a failure.",
    "resultShape": "admitted requests were 100% 200; every rejection was a 429 carrying Retry-After and RateLimit-Policy; no 5xx and no transport error occurred in any phase"
  },
