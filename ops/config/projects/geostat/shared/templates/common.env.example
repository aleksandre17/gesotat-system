# ============================================================
#  GeoStat System — Environment Variables
# ============================================================
#  Development:   cp .env.example .env.dev   → docker-compose.dev.yml
#  Production:    cp .env.example .env.prod  → docker-compose.prod.yml
# ============================================================

# ── App Version ──────────────────────────────────────────────
APP_VERSION=0.0.1-SNAPSHOT
# CI must set this to the immutable source commit/tag before image build.
IMAGE_REVISION=SET_BY_CI

# ── Ports ────────────────────────────────────────────────────
API_PORT=8081
MOBILE_PORT=8082

# ── Primary Database (geostat-system) ────────────────────────
DB_PRIMARY_URL=jdbc:sqlserver://YOUR_HOST;databaseName=geostat-system;encrypt=true;trustServerCertificate=true;serverTimezone=Asia/Tbilisi;cachePrepStmts=true
DB_PRIMARY_USER=sa
DB_PRIMARY_PASS=CHANGE_ME

# ── Secondary Database (auto) ────────────────────────────────
DB_SECONDARY_URL=jdbc:sqlserver://YOUR_HOST;databaseName=auto;encrypt=true;trustServerCertificate=true;serverTimezone=Asia/Tbilisi;cachePrepStmts=true
DB_SECONDARY_USER=sa
DB_SECONDARY_PASS=CHANGE_ME

# ── Shared active data plane (geostat-data) ──────────────────
DB_DATA_URL=jdbc:sqlserver://YOUR_HOST;databaseName=geostat-data;encrypt=true;trustServerCertificate=true
DB_DATA_USER=sa
DB_DATA_PASS=CHANGE_ME

# ── Immutable archive plane (geostat-archive) ────────────────
DB_ARCHIVE_URL=jdbc:sqlserver://YOUR_HOST;databaseName=geostat-archive;encrypt=true;trustServerCertificate=true
DB_ARCHIVE_USER=sa
DB_ARCHIVE_PASS=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_SECURE_64_CHAR_HEX_STRING
JWT_ISSUER=geostat-api
JWT_AUDIENCE=geostat-platform
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=86400000
JPA_DDL_AUTO=validate
PLATFORM_RATE_LIMIT_REQUESTS=120
PLATFORM_RATE_LIMIT_WINDOW_MS=60000
PLATFORM_RATE_LIMIT_MAX_CLIENT_KEYS=10000
PLATFORM_RATE_LIMIT_REDIS_ENABLED=false
# Required only when the approved distributed quota provider is Redis.
PLATFORM_RATE_LIMIT_REDIS_URL=redis://:REPLACE_WITH_SECRET@redis:6379/0
PLATFORM_RATE_LIMIT_REDIS_KEY_PREFIX=geostat:rate-limit
OTEL_METRICS_ENABLED=false
# Enable only after an approved durable collector/backend is configured.
OTEL_METRICS_ENDPOINT=http://geostat-otel-collector:4318/v1/metrics
OTEL_METRICS_STEP=60s
PLATFORM_QUERY_COST_MAX=5000
GEOSTAT_REDIS_PASSWORD=generate-a-strong-32-byte-secret
GRAFANA_ADMIN_PASSWORD=generate-a-strong-32-byte-secret
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=generate-a-strong-database-secret
KEYCLOAK_HOSTNAME=keycloak.example.internal
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=generate-a-strong-admin-secret
PLATFORM_QUERY_MAX_EXPORT_BYTES=52428800
PLATFORM_QUERY_MAX_REQUEST_BYTES=262144

# ── S3-compatible object storage (MinIO) ──────────────────────
STORAGE_ENDPOINT=http://minio:9000
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY_MIN_8_CHARS
STORAGE_BUCKET_INGEST=geostat-ingest
STORAGE_BUCKET_QUARANTINE=geostat-quarantine
STORAGE_BUCKET_ARCHIVE=geostat-archive
STORAGE_BUCKET_EXPORT=geostat-export
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
KIDS_SQL_PASSWORD=CHANGE_ME_KIDS_SQL_PASSWORD

PLATFORM_CURSOR_SIGNING_SECRET=replace-with-a-long-random-secret
PLATFORM_CORS_ALLOWED_ORIGINS=https://example.geostat.ge
PLATFORM_CORS_ALLOWED_ORIGIN_PATTERNS=
PLATFORM_MAX_ACCESS_ARTIFACT_BYTES=1073741824
