# Canonical GEOSOTAT API endpoint for this site.
VITE_PLATFORM_API_URL=http://localhost:8083/api/v1

# browser | oidc | none (none is allowed only for local development)
VITE_PLATFORM_AUTH_MODE=oidc

# Runtime-only token storage key; no token value belongs in this file.
VITE_PLATFORM_TOKEN_STORAGE_KEY=geostat_access_token

# true only during an approved legacy migration window.
VITE_LEGACY_API_FALLBACK=false

# Site contract identity is immutable application metadata.
VITE_SITE_CONTRACT_CODE=KIDS_PORTAL_V1
VITE_SITE_CONTRACT_REVISION=8
