{
  "prefix": "zz-sectest-",
  "description": "throwaway runtime security acceptance client; delete after the run",
  "provider": {
    "container": "geostat-keycloak",
    "adminCli": "/opt/keycloak/bin/kcadm.sh",
    "adminServer": "http://localhost:8080",
    "adminRealm": "master",
    "adminUserEnv": "KC_BOOTSTRAP_ADMIN_USERNAME",
    "adminPasswordEnv": "KC_BOOTSTRAP_ADMIN_PASSWORD",
    "realm": "geostat"
  },
  "clients": [
    {
      "clientId": "zz-sectest-no-audience",
      "purpose": "authority-signed token that does not carry the API audience",
      "realmRoles": ["contract.read"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "geostat",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-no-tenant",
      "purpose": "authority-signed token with the right audience but without the required tenant claim",
      "realmRoles": ["contract.read"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-no-roles",
      "purpose": "fully valid token that carries no role at all",
      "realmRoles": [],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "geostat",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-short-lifespan",
      "purpose": "fully valid token with a one-second access token lifespan, used after it expires",
      "realmRoles": ["contract.read"],
      "defaultClientScopes": [],
      "attributes": { "access.token.lifespan": "1" },
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "geostat",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-own-tenant",
      "purpose": "POSITIVE CONTROL: the read role and the SAME tenant as the product, WITHOUT the cross-tenant role",
      "realmRoles": ["contract.read"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "geostat",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-own-tenant-writer",
      "purpose": "POSITIVE CONTROL for id-addressed routes: read+write roles, product's own tenant, no cross-tenant role",
      "realmRoles": ["contract.read", "contract.write"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "geostat",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-foreign-tenant-writer",
      "purpose": "read+write roles and a foreign tenant, for the id-addressed routes that demand the write authority",
      "realmRoles": ["contract.read", "contract.write"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "zz-sectest-foreign-tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-blank-tenant",
      "purpose": "the tenant claim is present but whitespace only",
      "realmRoles": ["contract.read"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "geostat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "zz-sectest-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "   ",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zz-sectest-foreign-tenant",
      "purpose": "valid token with the read role but a tenant value that owns none of the data",
      "realmRoles": ["contract.read"],
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "zz-sectest-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
